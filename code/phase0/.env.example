# Copier ce fichier en .env et remplir les valeurs. Le .env n'est jamais commité.

# Mot de passe du compte admin de la Reolink.
REOLINK_PASSWORD=change-me

# Compte viewer créé dans Frigate pour House Sync.
SYNC_FRIGATE_USER=sync
SYNC_FRIGATE_PASSWORD=change-me

# Adresse de Frigate telle que le navigateur la voit (direct et dernière image) : l'adresse du PC sur le réseau.
FRIGATE_PUBLIC_URL=https://localhost:8971

# Clé secrète que l'utilisateur donne à House API depuis la WebApp (8 caractères au moins).
API_KEY=change-me

# Hôtes du certificat de la maison, séparés par des virgules : l'IP du PC et les noms par lesquels on ouvre
# la WebApp et Frigate. Si la liste change, le certificat est refait au prochain démarrage.
CERT_HOSTS=192.168.1.66,localhost
