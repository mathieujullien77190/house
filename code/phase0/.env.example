# Copier ce fichier en .env et remplir les valeurs. Le .env n'est jamais commité.

# Mot de passe du compte admin de la Reolink (lu par go2rtc, jamais écrit dans un fichier du dépôt).
REOLINK_PASSWORD=change-me

# Clé secrète que l'utilisateur donne à House API depuis la WebApp (8 caractères au moins).
API_KEY=change-me

# Hôtes du certificat de la maison, séparés par des virgules : l'IP du PC et les noms par lesquels on ouvre
# la WebApp et la page de House Sync. Si la liste change, le certificat est refait au prochain démarrage.
CERT_HOSTS=192.168.1.66,localhost

# Compte admin de la page web du switch (pour couper ou rendre le PoE d'une caméra). Sans mot de passe, la fonction est désactivée.
SWITCH_USER=admin
SWITCH_PASSWORD=change-me
