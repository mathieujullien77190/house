{
  "name": "house-sync",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "start": "node src/index.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=src/testing.ts --test-coverage-exclude=src/index.ts --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 \"src/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1"
  }
}
