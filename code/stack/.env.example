# Copier ce fichier en .env et remplir les valeurs. Le .env n'est jamais commité.

# Mot de passe du compte admin de la Reolink (lu par go2rtc, jamais écrit dans un fichier du dépôt).
# Mot de passe du compte admin de voliere-exterieur (la première caméra).
REOLINK_PASSWORD=change-me

# Clé secrète que l'utilisateur donne à House API depuis la WebApp (8 caractères au moins).
API_KEY=change-me

# Hôtes du certificat de la maison, séparés par des virgules : l'IP du PC et les noms par lesquels on ouvre
# la WebApp et la page de House Sync. Si la liste change, le certificat est refait au prochain démarrage.
CERT_HOSTS=192.168.1.66,localhost
# Sur le mini PC : CERT_HOSTS=mini.local,192.168.1.139,192.168.27.139,mini,localhost (192.168.27.139 : son adresse vue du VPN)

# La deuxième caméra (voliere-interieur), enregistrée par le même motion et vue par le même go2rtc que voliere-exterieur.
CAMERA2_IP=192.168.1.52
CAMERA2_USER=admin
CAMERA2_PASSWORD=change-me

# Compte admin de la page web du switch (pour couper ou rendre le PoE d'une caméra). Sans mot de passe, la fonction est désactivée.
SWITCH_USER=admin
SWITCH_PASSWORD=change-me

# Pont Philips Hue : son adresse et la clé d application (créée par un appui sur le bouton rond du pont : POST http://<pont>/api avec {"devicetype":"house#mini"}). Sans clé, le service hue est désactivé.
HUE_BRIDGE_IP=192.168.1.81
# Les climatisations Mitsubishi (onglet Clim) : « id:nom:adresse du module Wi-Fi MAC-577IF-E », séparées par des virgules. Sans valeur, le service est désactivé.
# AC_UNITS=chambre-invite:Chambre invité:192.168.1.130
# La prise connectée TP-Link Kasa HS100 (onglet Prise de la WebApp) : son adresse sur le réseau de la maison.
PLUG_HOST=192.168.1.200
# Sa MAC : si la box change l'adresse de la prise, l'API la retrouve par un scan du réseau.
PLUG_MAC=D8:0D:17:1C:84:E3
HUE_APP_KEY=change-me
# Facultatif : nombre de jours gardés par le journal des lampes (House Sync, table hue_events). 365 par défaut.
# HUE_LOG_DAYS=365

# La troisième caméra (salon-de-jardin), à côté de la cage, enregistrée par le même motion et vue par le même go2rtc.
CAMERA3_IP=192.168.1.171
CAMERA3_USER=admin
CAMERA3_PASSWORD=change-me

# La quatrième caméra (voliere-toit), sur le toit, enregistrée par le même motion et vue par le même go2rtc.
CAMERA4_IP=192.168.1.57
CAMERA4_USER=admin
CAMERA4_PASSWORD=change-me
